{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": "/api/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
